msgstr "የይለፍ ቃል"

msgid "Invalid Phone Format. Please use 09..., 07... or +251..."
msgstr "የተሳሳተ የስልክ ፎርማት። እባክዎ 09...፣ 07... ወይም +251... ይጠቀሙ።"

msgid "This email is already in use by another account."
msgstr "ይህ ኢሜይል አስቀድሞ በሌላ አካውንት ጥቅም ላይ ውሏል።"

msgid "First Name"
msgstr "ስም"

msgid "Last Name"
msgstr "የአባት ስም"

msgid "Confirm Password"
msgstr "የይለፍ ቃሉን ያረጋግጡ"

msgid "Phone Number"
msgstr "የስልክ ቁጥር"

msgid "Email Address"
msgstr "የኢሜይል አድራሻ"

msgid "Invalid Format. Use 09..., 07..., or +251..."
msgstr "የተሳሳተ ፎርማት። 09...፣ 07...፣ ወይም +251... ይጠቀሙ።"

msgid "This phone number is already registered. Please login."
msgstr "ይህ የስልክ ቁጥር አስቀድሞ ተመዝግቧል። እባክዎ ይግቡ (Login)።"

msgid "Passwords do not match."
msgstr "የይለፍ ቃላቱ አይመሳሰሉም።"

msgid "This email is already registered. Please login."
msgstr "ይህ ኢሜይል አስቀድሞ ተመዝግቧል። እባክዎ ይግቡ (Login)።"

msgid "City"
msgstr "ከተማ"

msgid "e.g. Addis Ababa or Hawassa"
msgstr "ምሳሌ፡ አዲስ አበባ ወይም ሀዋሳ"

msgid "Please type the exact spelling of your city."
msgstr "እባክዎ የከተማዎን ትክክለኛ የፊደል አጻጻፍ ያስገቡ።"

msgid "Institution / Company / Self-Learning"
msgstr "ተቋም / ኩባንያ / ራስ-አስተማሪ"

msgid "e.g. Addis Ababa University, Ethio Telecom, or Self-Learning"
msgstr "ምሳሌ፡ አዲስ አበባ ዩኒቨርሲቲ፣ ኢትዮ ቴሌኮም ወይም ራስ-አስተማሪ"

msgid "Enter your institution, company, or write 'Self-Learning' if you're studying independently."
msgstr "ተቋምዎን ወይም ኩባንያዎን ያስገቡ፤ በግልዎ የሚማሩ ከሆነ 'ራስ-አስተማሪ' ብለው ይፃፉ።"

msgid "Professional / Academic Identity"
msgstr "ሙያዊ / አካዳሚክ ማንነት"

msgid "e.g. Third Year Computer Science Student"
msgstr "ምሳሌ፡ የሶስተኛ ዓመት የኮምፒውተር ሳይንስ ተማሪ"

msgid "Write fully (e.g., Software Developer or Senior Accountant)."
msgstr "በሙሉ ይፃፉ (ምሳሌ፡ ሶፍትዌር ዴቨሎፐር ወይም ሲኒየር አካውንታንት)።"

msgid "User who owns this social link"
msgstr "የዚህ ማህበራዊ ገጽ ሊንክ ባለቤት"

msgid "Platform"
msgstr "ፕላትፎርም"

msgid "e.g., LinkedIn, Twitter, GitHub"
msgstr "ምሳሌ፡ LinkedIn, Twitter, GitHub"

msgid "URL Payload"
msgstr "የ URL መረጃ"

msgid "Full URL to the social profile"
msgstr "ወደ ማህበራዊ ገጽ ፕሮፋይሉ የሚወስድ ሙሉ URL"

msgid "Icon identifier for UI rendering"
msgstr "ለአይኮን መለያ የሚያገለግል መረጃ"

msgid "Display order on profile"
msgstr "በፕሮፋይል ላይ የሚታይበት ቅደም ተከተል"

msgid "Social Link"
msgstr "የማህበራዊ ገጽ ሊንክ"

msgid "Social Links"
msgstr "የማህበራዊ ገጽ ሊንኮች"

msgid "User who owns this contact method"
msgstr "የዚህ መገናኛ ዘዴ ባለቤት የሆነ ተጠቃሚ"

msgid "Platform / Method"
msgstr "ፕላትፎርም / ዘዴ"

msgid "e.g., Email, Phone, WhatsApp, Telegram"
msgstr "ምሳሌ፡ ኢሜይል፣ ስልክ፣ WhatsApp፣ ቴሌግራም"

msgid "Contact Value"
msgstr "የመገናኛ መረጃው"

msgid "Actual contact information (address, number, handle)"
msgstr "ትክክለኛው የመገናኛ መረጃ (አድራሻ፣ ቁጥር፣ አድራሻ)"

msgid "Contact Method"
msgstr "የመገናኛ ዘዴ"

msgid "Contact Methods"
msgstr "የመገናኛ ዘዴዎች"

msgid "Phone number must be entered in the format: '+251911234567'. Up to 15 digits allowed."
msgstr "የስልክ ቁጥር በዚህ ፎርማት መግባት አለበት፡ '+251911234567'። እስከ 15 አሃዞች ይፈቀዳሉ።"

msgid "The Phone Number must be provided for authentication."
msgstr "ለማንነት ማረጋገጫ (Authentication) የስልክ ቁጥር መቅረብ አለበት።"

msgid "Superuser must have is_staff=True."
msgstr "Superuser 'is_staff=True' መሆን አለበት።"

msgid "Superuser must have is_superuser=True."
msgstr "Superuser 'is_superuser=True' መሆን አለበት።"

msgid "Founder"
msgstr "መስራች (Founder)"

msgid "Expert"
msgstr "ባለሙያ (Expert)"

msgid "Visionary"
msgstr "ባለራዕይ (Visionary)"

msgid "Admin"
msgstr "አስተዳዳሪ (Admin)"

msgid "A user with this phone number already exists."
msgstr "በዚህ የስልክ ቁጥር የተመዘገበ ተጠቃሚ አስቀድሞ አለ።"

msgid "Primary authentication identifier. Format: +251911234567"
msgstr "ዋና የማንነት ማረጋገጫ መለያ። ፎርማት፡ +251911234567"

msgid "Public Badge"
msgstr "ይፋዊ ባጅ (Public Badge)"

msgid "Human-readable unique ID (e.g., VIS-2024-001). Auto-generated."
msgstr "በቀላሉ ሊነበብ የሚችል ልዩ መለያ (ምሳሌ፡ VIS-2024-001)። በራስ-ሰር የሚፈጠር።"

msgid "Determines platform access and profile features"
msgstr "የፕላትፎርም አጠቃቀምን እና የፕሮፋይል አገልግሎቶችን ይወስናል"

msgid "Legal Name"
msgstr "ህጋዊ ስም"

msgid "Official name for professional correspondence"
msgstr "ለሙያዊ ግንኙነቶች የሚያገለግል ኦፊሴላዊ ስም"

msgid "Primary email for notifications and account recovery"
msgstr "ለማሳወቂያዎች እና አካውንት ማግኛ የሚያገለግል ዋና ኢሜይል"

msgid "Email Verified"
msgstr "ኢሜይል ተረጋግጧል"

msgid "Indicates if the user's primary email has been verified"
msgstr "የተጠቃሚው ዋና ኢሜይል መረጋገጡን ያሳያል"

msgid "Email OTP"
msgstr "የኢሜይል OTP"

msgid "One-time password for email verification"
msgstr "ለኢሜይል ማረጋገጫ የአንድ ጊዜ የይለፍ ቃል (OTP)"

msgid "OTP Created At"
msgstr "OTP የተፈጠረበት ጊዜ"

msgid "Timestamp when the email OTP was generated"
msgstr "የኢሜይል OTP የተፈጠረበት ጊዜ"

msgid "Telegram Handle"
msgstr "የቴሌግራም አድራሻ (@username)"

msgid "@username for community communication"
msgstr "ለኮሚኒቲ ግንኙነት የሚያገለግል @username"

msgid "User country selected from verified countries"
msgstr "ከተረጋገጡ ሀገራት የተመረጠ የተጠቃሚ ሀገር"

msgid "User city selected from verified cities"
msgstr "ከተረጋገጡ ከተሞች የተመረጠ የተጠቃሚ ከተማ"

msgid "Current Location"
msgstr "የአሁኑ አድራሻ"

msgid "City, Country for networking purposes"
msgstr "ከተማ እና ሀገር ለኔትወርኪንግ አገልግሎት"

msgid "Avatar"
msgstr "አቫታር (ምስል)"

msgid "Profile picture. Auto-optimized to WebP format"
msgstr "የፕሮፋይል ምስል። በራስ-ሰር ወደ WebP ፎርማት የተቀየረ"

msgid "Cover Image"
msgstr "የጀርባ ምስል (Cover Image)"

msgid "Header image. Role-based fallbacks available"
msgstr "የራስጌ ምስል። እንደየስራ ድርሻው የሚለዋወጥ"

msgid "Verification Status"
msgstr "የማረጋገጫ ሁኔታ"

msgid "Identity verification completion status"
msgstr "የማንነት ማረጋገጫ ሂደት የደረሰበት ደረጃ"

msgid "Active Switch"
msgstr "አክቲቭ ስዊች"

msgid "Account suspension control"
msgstr "የአካውንት እገዳ መቆጣጠሪያ"

msgid "Public Visibility"
msgstr "ለህዝብ የታይነት ሁኔታ"

msgid "If unchecked, user vanishes from Network/Nexus but can apply to jobs"
msgstr "ምልክቱ ካልተደረገበት፣ ተጠቃሚው ከኔትወርኩ ይጠፋል ነገር ግን ለስራዎች ማመልከት ይችላል"

msgid "Visible in Public Feed"
msgstr "በይፋዊ ፊድ (Public Feed) ላይ የሚታይ"

msgid "Uncheck to ban user from public Nexus feed"
msgstr "ተጠቃሚውን ከይፋዊ ኔክሰስ (Nexus) ፊድ ለማገድ ይህን ምልክት ያጥፉ"

msgid "Admin Selected"
msgstr "በአስተዳዳሪ የተመረጠ"

msgid "Pin this user to the top of the Nexus Feed"
msgstr "ይህንን ተጠቃሚ በኔክሰስ ፊድ አናት ላይ ፒን ያድርጉ"

msgid "Pinned in Right Now Feed"
msgstr "በአሁኑ (Right Now) ፊድ ውስጥ የተሰካ (Pinned)"

msgid "Pin this user to the absolute top of the Right Now (Live Intent) feed."
msgstr "ይህንን ተጠቃሚ በ'አሁን' (Right Now) ፊድ አናት ላይ ይሰኩ (Pin ያድርጉ)።"

msgid "Banned from Right Now Feed"
msgstr "ከ'አሁን' (Right Now) ፊድ የታገደ"

msgid "Completely hide this user from the Right Now feed (if they post spam/generic missions)."
msgstr "ይህንን ተጠቃሚ ከ'አሁን' ፊድ ሙሉ በሙሉ ይደብቁ (ስፓም/የማይረቡ መረጃዎች የሚለጥፉ ከሆነ)።"

msgid "Home Page Avatar Selected"
msgstr "የመነሻ ገጽ አቫታር ተመርጧል"

msgid "Pin this user to the top hero section avatar cluster on the landing page."
msgstr "በመነሻ ገጹ ዋና ክፍል (Hero section) አቫታር ስብስብ ላይ ይህንን ተጠቃሚ ይሰኩ (Pin ያድርጉ)።"

msgid "Home Page Profile Selected"
