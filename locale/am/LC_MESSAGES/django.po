msgid "Profile Admin Rating"
msgstr "የፕሮፋይል አስተዳዳሪ ሬቲንግ"

msgid "Curate the user's rating (0-5). Automatically syncs to their active Expert, Visionary, or Founder profile."
msgstr "የተጠቃሚውን ሬቲንግ (0-5) ያስተካክሉ። ይህም በቀጥታ ወደ ሚጠቀሙበት የኤክስፐርት፣ ቪዥነሪ፣ ወይም ፋውንደር ፕሮፋይል በራስ-ሰር ይመሳሰላል።"

msgid "Admin Rating Lock"
msgstr "የአስተዳዳሪ ሬቲንግ መቆለፊያ"

msgid "Check this to stop the AI Oracle from auto-updating this rating."
msgstr "የ AI ኦራክል (Oracle) ይህን ሬቲንግ በራስ-ሰር እንዳያስተካክል ለማገድ ይህን ይምረጡ።"

msgid "User does not have an active profile yet. Cannot set rating."
msgstr "ተጠቃሚው እስካሁን ንቁ (Active) ፕሮፋይል የለውም። ሬቲንግ ማስተካከል አይቻልም።"

msgid "Profile required to lock rating."
msgstr "ሬቲንግ ለመቆለፍ ፕሮፋይል ያስፈልጋል።"

msgid "Leave blank to keep current password."
msgstr "የአሁኑን የይለፍ ቃል እንዳለ ለማቆየት ባዶውን ይተዉት።"

msgid "Identity & Role"
msgstr "ማንነት እና የስራ ድርሻ"

msgid "🏠 Home Page Curation"
msgstr "🏠 የመነሻ ገጽ ዝግጅት"

msgid "🛡️ Feed Control & Moderation"
msgstr "🛡️ የፊድ ቁጥጥር እና ሞደሬሽን"

msgid "Security & Access"
msgstr "ደህንነት እና አቅርቦት"

msgid "Permissions & Groups"
msgstr "ፈቃዶች እና ቡድኖች"

msgid "Timestamps"
msgstr "የጊዜ መዝገቦች"

msgid "User Identity"
msgstr "የተጠቃሚ ማንነት"

msgid "Contact Info"
msgstr "የመገናኛ መረጃ"

msgid "Role & Rating"
msgstr "ድርሻ እና ሬቲንግ"

msgid "Status"
msgstr "ሁኔታ"

msgid "CV Document"
msgstr "የሲቪ (CV) ሰነድ"

msgid "Contact Status"
msgstr "የግንኙነት ሁኔታ"

msgid "Staff Member"
msgstr "የሰራተኛ አባል"

msgid "Cities"
msgstr "ከተሞች"

