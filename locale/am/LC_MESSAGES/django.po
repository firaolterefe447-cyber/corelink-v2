msgstr "የአመልካቾች ቦርድ"

msgid "My Portfolio"
msgstr "የእኔ ፖርትፎሊዮ"

msgid "Pipeline Management"
msgstr "የሂደት ማኔጅመንት"

msgid "Review Board"
msgstr "የግምገማ ቦርድ"

msgid "Applicants"
msgstr "አመልካቾች"

msgid "No cover note."
msgstr "ምንም ከቨር ኖት (Cover Note) የለም።"

msgid "Pass"
msgstr "እለፍ"

