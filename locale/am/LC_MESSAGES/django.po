msgstr "እባክዎ ለፕሮፋይልዎ ንጹህ ፕሮፌሽናል ምስል ይጫኑ።"

msgid "UPLOAD NEW PHOTO"
msgstr "አዲስ ፎቶ ይጫኑ"

msgid "REMOVE PHOTO"
msgstr "ፎቶውን ያጥፉ"

msgid "Background Banner"
msgstr "የጀርባ ባነር"

msgid "Upload a wide background banner that represents your professional space and personal branding."
msgstr "የሙያ መስክዎን እና የግል ብራንድዎን የሚወክል ሰፊ የጀርባ ባነር ይጫኑ።"

msgid "Discover Talent"
msgstr "ባለሙያዎችን (Talent) ያግኙ"

msgid "Our Mission"
msgstr "የእኛ ተልዕኮ"

msgid "Log In"
msgstr "ይግቡ"

msgid "Join corelink"
msgstr "ኮርሊንክን ይቀላቀሉ"

msgid "CoreLink"
msgstr "ኮርሊንክ"

msgid "Ethiopia."
msgstr "ኢትዮጵያ።"

msgid "An Ethiopian Professional Community."
msgstr "የኢትዮጵያውያን ባለሙያዎች ኮሚኒቲ።"

msgid "The home for the nation's most ambitious talent and verified professionals"
msgstr "ለሀገሪቱ ምርጥ ታለንቶች እና የተረጋገጡ ባለሙያዎች መነሃሪያ"

msgid "Facilitating discovery, innovation, and collaboration: Connecting opportunity across the nation."
msgstr "ግኝትን፣ ኢኖቬሽንን፣ እና ትብብርን ማሳለጥ፡ እድሎችን በመላው ሀገሪቱ ማገናኘት።"

msgid "Start Your Journey"
msgstr "ጉዞዎን ይጀምሩ"

msgid "Join verified Ethiopian professionals."
msgstr "የተረጋገጡ ኢትዮጵያውያን ባለሙያዎችን ይቀላቀሉ።"

msgid "Built to Unite Ethiopia's <br> Professional Family."
msgstr "የኢትዮጵያን የሙያ ቤተሰብ <br> አንድ ለማድረግ የተገነባ።"

msgid "CoreLink is Ethiopian-based, created to unite professionals, students, and business owners into a single, vibrant family. We are a space for innovation, creating real opportunities for our country's emerging talent and connecting them to the exact places they need to grow."
msgstr "ኮርሊንክ ኢትዮጵያ ውስጥ የተመሰረተ፣ ባለሙያዎችን፣ ተማሪዎችን እና የቢዝነስ ባለቤቶችን ወደ አንድ ቤተሰብ ለማምጣት የተፈጠረ ነው። እኛ ለሀገራችን ታዳጊ ባለሙያዎች እውነተኛ እድሎችን የምንፈጥርበት እና እንዲያድጉ ወደሚያስፈልጋቸው ትክክለኛ ቦታዎች የምናገናኝበት የኢኖቬሽን ማዕከል ነን።"

msgid "We are the living network that Ethiopia has been waiting for. We provide powerful digital visibility and optimization for Ethiopian-based businesses and companies, ensuring that every connection made is a step forward for the nation as a whole."
msgstr "እኛ ኢትዮጵያ ስትጠብቀው የነበረው ህያው ኔትወርክ ነን። ኢትዮጵያ ውስጥ ላሉ ቢዝነሶች እና ኩባንያዎች ጠንካራ ዲጂታል ታይነት እና እድገት እንሰጣለን፣ የሚፈጠረው እያንዳንዱ ግንኙነት ለሀገሪቱ በሙሉ አንድ እርምጃ ወደፊት መሆኑን እናረጋግጣለን።"

msgid "Network"
msgstr "ኔትወርክ"

msgid "Meet Your Match."
msgstr "ተመራጭዎን ያግኙ።"

msgid "Whether it's finding a co-founder for a business, meeting like-minded peers, or reaching for better job opportunities, CoreLink opens the door into our community's talent pool, making it easy to find the exact skills and professionals you need to succeed."
msgstr "ለቢዝነስዎ ተባባሪ መስራች (Co-founder) መፈለግም ሆነ፣ ተመሳሳይ አመለካከት ካላቸው ሰዎች ጋር መገናኘት፣ ወይም ለተሻለ የስራ እድል መጣር ቢሆን፣ ኮርሊንክ ወደ ኮሚኒቲያችን የታለንት ማዕከል በሩን ይከፍታል፣ ለስኬትዎ የሚፈልጓቸውን ክህሎቶች እና ባለሙያዎች በቀላሉ እንዲያገኙ ያደርጋል።"

msgid "Co-founders"
msgstr "ተባባሪ መስራቾች"

msgid "Peers & Mentors"
msgstr "አቻዎች እና ሜንቶሮች"

msgid "Job Opportunities"
msgstr "የስራ እድሎች"

msgid "Collaborators"
msgstr "ተባባሪዎች (Collaborators)"

msgid "For Business"
msgstr "ለቢዝነስ"

msgid "Your Business, Discoverable by the World."
msgstr "የእርስዎ ቢዝነስ፣ ለዓለም እንዲታይ።"

msgid "Ethiopian startups, companies, businesses, and organizations build their profile on CoreLink by listing their services, telling their story, and making themselves discoverable, by both local and international clients."
msgstr "የኢትዮጵያ ስታርትአፖች፣ ኩባንያዎች፣ ቢዝነሶች፣ እና ድርጅቶች አገልግሎቶቻቸውን በመዘርዘር፣ ታሪካቸውን በማካፈል፣ እና በአገር ውስጥም ሆነ በዓለም አቀፍ ደንበኞች በቀላሉ እንዲገኙ በማድረግ ፕሮፋይላቸውን በኮርሊንክ ላይ ይገነባሉ።"

msgid "No more relying on scattered word of mouth. Your digital storefront is live, searchable, and always working. Clients can browse your service catalog, read about your expertise, and contact you directly, from anywhere in the world."
msgstr "ከእንግዲህ በተበታተኑ ወሬዎች ላይ መታመን ቀርቷል። የእርስዎ ዲጂታል ሱቅ ቀጥታ (Live)፣ በቀላሉ የሚፈለግ እና ሁሌም የሚሰራ ነው። ደንበኞች የአገልግሎት ማውጫዎን ማሰስ፣ ስለ ሙያዎ ማንበብ እና ከየትኛውም የዓለም ክፍል በቀጥታ ሊያገኙዎት ይችላሉ።"

msgid "And when it is time to grow your team, you can instantly search our verified talent pool and find the exact professional your business needs, in your city, at the right moment."
msgstr "እናም ቡድንዎን ለማሳደግ ጊዜው ሲደርስ፣ የተረጋገጠውን የታለንት ማዕከላችንን በፍጥነት በመፈለግ ቢዝነስዎ የሚፈልገውን ትክክለኛ ባለሙያ፣ በከተማዎ ውስጥ፣ በትክክለኛው ጊዜ ማግኘት ይችላሉ።"

msgid "Business Profile"
msgstr "የቢዝነስ ፕሮፋይል"

msgid "Service Catalog"
msgstr "የአገልግሎት ማውጫ (Catalog)"

msgid "Local & Global Reach"
msgstr "የአገር ውስጥ እና ዓለም አቀፍ ተደራሽነት"

msgid "Hire Verified Talent"
msgstr "የተረጋገጡ ባለሙያዎችን ይቅጠሩ"

msgid "For Talent"
msgstr "ለባለሙያዎች (Talent)"

msgid "Your Proof of Work, Seen by the Right People."
msgstr "የእርስዎ የስራ ማስረጃ (Proof of Work)፣ በትክክለኛ ሰዎች እንዲታይ።"

msgid "Ethiopian talent deserves a professional identity that goes beyond a PDF. CoreLink gives professionals, developers, designers, researchers, strategists, the space to build a deep profile that shows the world exactly what they are capable of."
msgstr "የኢትዮጵያ ባለሙያዎች ከPDF ባለፈ ሙያዊ ማንነት ይገባቸዋል። ኮርሊንክ ለባለሙያዎች፣ ዴቨሎፐሮች፣ ዲዛይነሮች፣ ተመራማሪዎች፣ እና ስትራቴጂስቶች ምን ማድረግ እንደሚችሉ ለዓለም በትክክል የሚያሳይ ጥልቅ ፕሮፋይል የሚገነቡበትን ቦታ ይሰጣል።"

msgid "Link your GitHub projects, upload design portfolios, publish your research, and let your proof of work speak louder than any resume ever could."
msgstr "የGitHub ፕሮጀክቶችዎን ያገናኙ፣ የዲዛይን ፖርትፎሊዮዎችን ይጫኑ፣ ጥናትዎን ያትሙ፣ እና የስራ ማስረጃዎ ከማንኛውም ሲቪ (Resume) በላይ እንዲናገር ያድርጉ።"

msgid "With that profile live on CoreLink, you are no longer waiting. Local companies find you. International opportunities reach you. Whether you are looking for full-time roles, freelance work, or meaningful collaborations, our system connects your skills to the right doors, automatically."
