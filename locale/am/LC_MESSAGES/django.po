msgid "Profile Admin Rating"
msgstr "የፕሮፋይል አስተዳዳሪ ሬቲንግ"

msgid "Curate the user's rating (0-5). Automatically syncs to their Unified Portfolio."
msgstr "የተጠቃሚውን ሬቲንግ (0-5) ያስተካክሉ። ይህም በቀጥታ ወደ ሚጠቀሙበት የተዋሃደ ፖርትፎሊዮ (Unified Portfolio) በራስ-ሰር ይመሳሰላል።"

msgid "Admin Rating Lock"
msgstr "የአስተዳዳሪ ሬቲንግ መቆለፊያ"

msgid "Check this to stop the AI Oracle from auto-updating this rating."
msgstr "የ AI ኦራክል (Oracle) ይህን ሬቲንግ በራስ-ሰር እንዳያስተካክል ለማገድ ይህን ይምረጡ።"

msgid "User does not have an active Unified Portfolio yet. Cannot set rating."
msgstr "ተጠቃሚው እስካሁን ንቁ (Active) የተዋሃደ ፖርትፎሊዮ የለውም። ሬቲንግ ማስተካከል አይቻልም።"

msgid "Portfolio required to lock rating."
msgstr "ሬቲንግ ለመቆለፍ ፖርትፎሊዮ ያስፈልጋል።"

msgid "Leave blank to keep current password."
msgstr "የአሁኑን የይለፍ ቃል እንዳለ ለማቆየት ባዶውን ይተዉት።"

msgid "Identity & Role"
msgstr "ማንነት እና የስራ ድርሻ"

msgid "🏠 Home Page Curation"
msgstr "🏠 የመነሻ ገጽ ዝግጅት"

msgid "🛡️ Feed Control & Moderation"
msgstr "🛡️ የፊድ ቁጥጥር እና ሞደሬሽን"

msgid "Security & Access"
msgstr "ደህንነት እና አቅርቦት"

msgid "Permissions & Groups"
msgstr "ፈቃዶች እና ቡድኖች"

msgid "Timestamps"
msgstr "የጊዜ መዝገቦች"

msgid "User Identity"
msgstr "የተጠቃሚ ማንነት"

msgid "Contact Info"
msgstr "የመገናኛ መረጃ"

msgid "Role & Rating"
msgstr "ድርሻ እና ሬቲንግ"

msgid "Status"
msgstr "ሁኔታ"

msgid "CV Document"
msgstr "የሲቪ (CV) ሰነድ"

msgid "Contact Status"
msgstr "የግንኙነት ሁኔታ"

msgid "Staff Member"
msgstr "የሰራተኛ አባል"

msgid "Cities"
msgstr "ከተሞች"

msgid "Phone Number or Email"
msgstr "የስልክ ቁጥር ወይም ኢሜይል"

msgid "Password"
msgstr "የይለፍ ቃል"

msgid "Invalid Phone Format. Please use 09..., 07... or include country code (e.g., +86...)."
msgstr "የተሳሳተ የስልክ ፎርማት። እባክዎ 09...፣ 07... ወይም የሀገር ኮድ ያካቱ (ምሳሌ፡ +251...)።"

msgid "This email is already in use by another account."
msgstr "ይህ ኢሜይል አስቀድሞ በሌላ አካውንት ጥቅም ላይ ውሏል።"

msgid "Visionary"
msgstr "ባለራዕይ (Visionary)"

msgid "Expert"
msgstr "ባለሙያ (Expert)"

msgid "Founder"
msgstr "መስራች (Founder)"

msgid "Choose your role"
msgstr "ድርሻዎን ይምረጡ"

msgid "First Name"
msgstr "ስም"

msgid "Last Name"
msgstr "የአባት ስም"

msgid "Confirm Password"
msgstr "የይለፍ ቃሉን ያረጋግጡ"

msgid "Phone Number"
msgstr "የስልክ ቁጥር"

msgid "Email Address"
msgstr "የኢሜይል አድራሻ"

msgid "Invalid Format. Use 09..., 07..., or include your country code (e.g., +86...)."
msgstr "የተሳሳተ ፎርማት። 09...፣ 07...፣ ወይም የሀገር ኮድ ያካቱ (ምሳሌ፡ +251...)።"

msgid "This phone number is already registered. Please login."
msgstr "ይህ የስልክ ቁጥር አስቀድሞ ተመዝግቧል። እባክዎ ይግቡ (Login)።"

msgid "Passwords do not match."
msgstr "የይለፍ ቃላቱ አይመሳሰሉም።"

msgid "This email is already registered. Please login."
msgstr "ይህ ኢሜይል አስቀድሞ ተመዝግቧል። እባክዎ ይግቡ (Login)።"

msgid "City"
msgstr "ከተማ"

msgid "e.g. Addis Ababa or Hawassa"
msgstr "ምሳሌ፡ አዲስ አበባ ወይም ሀዋሳ"

msgid "Please type the exact spelling of your city."
msgstr "እባክዎ የከተማዎን ትክክለኛ የፊደል አጻጻፍ ያስገቡ።"

msgid "Institution / Company / Self-Learning"
msgstr "ተቋም / ኩባንያ / ራስ-አስተማሪ"

msgid "e.g. Addis Ababa University, Ethio Telecom, or Self-Learning"
msgstr "ምሳሌ፡ አዲስ አበባ ዩኒቨርሲቲ፣ ኢትዮ ቴሌኮም ወይም ራስ-አስተማሪ"

msgid "Enter your institution, company, or write 'Self-Learning'."
msgstr "ተቋምዎን ወይም ኩባንያዎን ያስገቡ፤ አለበለዚያ 'Self-Learning' ብለው ይፃፉ።"

msgid "Professional / Academic Identity"
msgstr "ሙያዊ / አካዳሚክ ማንነት"

msgid "e.g. Third Year Computer Science Student or Senior Dev"
msgstr "ምሳሌ፡ የሶስተኛ ዓመት የኮምፒውተር ሳይንስ ተማሪ ወይም ሲኒየር ዴቨሎፐር"

msgid "Write fully (e.g., Software Developer or Senior Accountant)."
msgstr "በሙሉ ይፃፉ (ምሳሌ፡ ሶፍትዌር ዴቨሎፐር ወይም ሲኒየር አካውንታንት)።"

msgid "About Me / Your Goals"
msgstr "ስለ እኔ / የእርስዎ ግቦች"

msgid "Tell us a bit about your background, what you are building, or what you want to achieve..."
msgstr "ስለ ዳራዎ፣ ምን እየገነቡ እንዳሉ፣ ወይም ምን ማሳካት እንደሚፈልጉ በጥቂቱ ይንገሩን..."

msgid "Share your story. This will act as the bio on your public portfolio."
msgstr "ታሪክዎን ያጋሩ። ይህ በይፋዊ ፖርትፎሊዮዎ ላይ እንደ ባዮ (Bio) ሆኖ ያገለግላል።"

msgid "Company / Startup Name"
msgstr "የኩባንያ / ስታርትአፕ ስም"

msgid "e.g. CoreLink Technologies"
msgstr "ምሳሌ፡ ኮርሊንክ ቴክኖሎጂስ"

msgid "Your Role in the Company"
msgstr "በኩባንያው ውስጥ ያለዎት የስራ ድርሻ"

msgid "e.g. Founder, CEO, Lead Developer"
msgstr "ምሳሌ፡ ፋውንደር (Founder)፣ ዋና ስራ አስፈፃሚ (CEO)፣ ሊድ ዴቨሎፐር"

msgid "Industry / Sector"
msgstr "ኢንዱስትሪ / ዘርፍ"

msgid "e.g. Fintech, EdTech, Agriculture"
msgstr "ምሳሌ፡ ፊንቴክ (Fintech)፣ ኤድቴክ (EdTech)፣ ግብርና"

msgid "Company Mission / Overview"
msgstr "የኩባንያው ተልዕኮ / አጠቃላይ እይታ"

msgid "What does your company do? What is the core mission or product you are building?"
msgstr "ኩባንያዎ ምን ይሰራል? እየገነቡት ያለው ዋና ተልዕኮ ወይም ምርት ምንድነው?"

msgid "Share your company's core mission. This will be displayed on the public Company Profile."
msgstr "የኩባንያዎን ዋና ተልዕኮ ያጋሩ። ይህ በይፋዊ የኩባንያ ፕሮፋይል ላይ ይታያል።"

msgid "IMPORTANT: We will send a verification link here. Please use your active, current email address."
msgstr "አስፈላጊ፡ የማረጋገጫ ሊንክ እዚህ እንልካለን። እባክዎ አሁን እየተጠቀሙበት ያለውን ትክክለኛ ኢሜይል ያስገቡ።"

msgid "Please specify your professional/academic identity."
msgstr "እባክዎ ሙያዊ / አካዳሚክ ማንነትዎን ይግለጹ።"

msgid "Please specify your institution or enter 'Self-Learning'."
msgstr "እባክዎ ተቋምዎን ይግለጹ ወይም 'Self-Learning' ብለው ያስገቡ።"

msgid "Company name is required."
msgstr "የኩባንያ ስም ማስገባት ግዴታ ነው።"

msgid "Your role in the company is required."
msgstr "በኩባንያው ውስጥ ያለዎት ድርሻ ማስገባት ግዴታ ነው።"

msgid "Please specify your industry sector."
msgstr "እባክዎ የኢንዱስትሪ ዘርፍዎን ይግለጹ።"

msgid "User who owns this social link"
msgstr "የዚህ ማህበራዊ ገጽ ሊንክ ባለቤት"

msgid "Platform"
msgstr "ፕላትፎርም"

msgid "e.g., LinkedIn, Twitter, GitHub"
msgstr "ምሳሌ፡ LinkedIn, Twitter, GitHub"

msgid "URL Payload"
msgstr "የ URL መረጃ"

msgid "Full URL to the social profile"
msgstr "ወደ ማህበራዊ ገጽ ፕሮፋይሉ የሚወስድ ሙሉ URL"

msgid "Icon identifier for UI rendering"
msgstr "ለአይኮን መለያ የሚያገለግል መረጃ"

msgid "Display order on profile"
msgstr "በፕሮፋይል ላይ የሚታይበት ቅደም ተከተል"

msgid "Social Link"
msgstr "የማህበራዊ ገጽ ሊንክ"

msgid "Social Links"
msgstr "የማህበራዊ ገጽ ሊንኮች"

msgid "User who owns this contact method"
msgstr "የዚህ መገናኛ ዘዴ ባለቤት የሆነ ተጠቃሚ"

msgid "Platform / Method"
msgstr "ፕላትፎርም / ዘዴ"

msgid "e.g., Email, Phone, WhatsApp, Telegram"
msgstr "ምሳሌ፡ ኢሜይል፣ ስልክ፣ WhatsApp፣ ቴሌግራም"

msgid "Contact Value"
msgstr "የመገናኛ መረጃው"

msgid "Actual contact information (address, number, handle)"
msgstr "ትክክለኛው የመገናኛ መረጃ (አድራሻ፣ ቁጥር፣ አድራሻ)"

msgid "Contact Method"
msgstr "የመገናኛ ዘዴ"

msgid "Contact Methods"
msgstr "የመገናኛ ዘዴዎች"

msgid "Phone number must be entered in the format: '+251911234567'. Up to 15 digits allowed."
msgstr "የስልክ ቁጥር በዚህ ፎርማት መግባት አለበት፡ '+251911234567'። እስከ 15 አሃዞች ይፈቀዳሉ።"

msgid "The Phone Number must be provided for authentication."
msgstr "ለማንነት ማረጋገጫ (Authentication) የስልክ ቁጥር መቅረብ አለበት።"

msgid "Superuser must have is_staff=True."
msgstr "Superuser 'is_staff=True' መሆን አለበት።"

msgid "Superuser must have is_superuser=True."
msgstr "Superuser 'is_superuser=True' መሆን አለበት።"

msgid "Admin"
msgstr "አስተዳዳሪ (Admin)"

msgid "A user with this phone number already exists."
msgstr "በዚህ የስልክ ቁጥር የተመዘገበ ተጠቃሚ አስቀድሞ አለ።"

msgid "Primary authentication identifier. Format: +251911234567"
msgstr "ዋና የማንነት ማረጋገጫ መለያ። ፎርማት፡ +251911234567"

msgid "Used for OTP verification and Google sign-in"
msgstr "ለ OTP ማረጋገጫ እና በGoogle ለመግባት ያገለግላል"

msgid "Public Badge"
msgstr "ይፋዊ ባጅ (Public Badge)"

msgid "Human-readable unique ID (e.g., VIS-2024-001). Auto-generated."
msgstr "በቀላሉ ሊነበብ የሚችል ልዩ መለያ (ምሳሌ፡ VIS-2024-001)። በራስ-ሰር የሚፈጠር።"

msgid "Determines platform access and profile features"
msgstr "የፕላትፎርም አጠቃቀምን እና የፕሮፋይል አገልግሎቶችን ይወስናል"

msgid "Legal Name"
msgstr "ህጋዊ ስም"

msgid "Official name for professional correspondence"
msgstr "ለሙያዊ ግንኙነቶች የሚያገለግል ኦፊሴላዊ ስም"

msgid "Primary email for notifications and account recovery"
msgstr "ለማሳወቂያዎች እና አካውንት ማግኛ የሚያገለግል ዋና ኢሜይል"

msgid "Email Verified"
msgstr "ኢሜይል ተረጋግጧል"

msgid "Indicates if the user's primary email has been verified"
msgstr "የተጠቃሚው ዋና ኢሜይል መረጋገጡን ያሳያል"

msgid "Email OTP"
msgstr "የኢሜይል OTP"

msgid "One-time password for email verification"
msgstr "ለኢሜይል ማረጋገጫ የአንድ ጊዜ የይለፍ ቃል (OTP)"

msgid "OTP Created At"
msgstr "OTP የተፈጠረበት ጊዜ"

msgid "Timestamp when the email OTP was generated"
msgstr "የኢሜይል OTP የተፈጠረበት ጊዜ"

msgid "Telegram Handle"
msgstr "የቴሌግራም አድራሻ (@username)"

msgid "@username for community communication"
