msgstr "ቀጣይ"

msgid "Expand Your Horizon"
msgstr "አድማስዎን ያስፉ"

msgid "No opportunities currently match those exact magic parameters. Clear your filters to explore the full ecosystem."
msgstr "በአሁኑ ጊዜ ከነዚህ መመዘኛዎች ጋር በትክክል የሚዛመዱ እድሎች የሉም። ሙሉውን ኤኮሲስተም ለማሰስ ማጣሪያዎችዎን ያጥፉ።"

msgid "Reset Search Criteria"
msgstr "የፍለጋ መስፈርቶችን ዳግም አስጀምር"

