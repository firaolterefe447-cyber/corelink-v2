msgstr "ይህ መልዕክቱን ከኮርሊንክ ሲስተም በቋሚነት ያጠፋዋል። ድርጊቱ ወደኋላ አይመለስም።"

msgid "Sent on"
msgstr "የተላከበት ቀን"

msgid "Yes, Recall Message"
msgstr "አዎ፣ መልዕክቱ ይጥፋ"

msgid "Edit Transmission"
msgstr "ትራንስሚሽኑን ያስተካክሉ"

msgid "Secure Transmission"
msgstr "ደህንነቱ የተጠበቀ ትራንስሚሽን"

msgid "A direct line to the platform administrators. Submit your request below and we will update the status in your workspace."
msgstr "ጥያቄዎን ለአስተዳዳሪዎች በቀጥታ ያቅርቡ። ሁኔታውን በዎርክስፔስዎ ውስጥ እናሳውቅዎታለን።"

msgid "Subject"
msgstr "ርዕሰ-ጉዳይ"

msgid "The Request"
msgstr "ጥያቄው"

msgid "Support requests are typically reviewed within 24 hours."
msgstr "የድጋፍ ጥያቄዎች ብዙ ጊዜ በ24 ሰዓት ውስጥ ይገመገማሉ።"

msgid "Submit Request"
msgstr "ጥያቄውን ያስገቡ"

msgid "Support Messages"
msgstr "የድጋፍ መልዕክቶች"

msgid "Your previous conversations with the CoreLink team. We're always here to help you grow."
msgstr "ከኮርሊንክ ቡድን ጋር ያደረጓቸው ንግግሮች። ሁልጊዜ እንዲያድጉ እንረዳዎታለን።"

msgid "New Message"
msgstr "አዲስ መልዕክት"

msgid "Resolved"
msgstr "ተፈቷል"

msgid "In Progress"
msgstr "በሂደት ላይ"

msgid "Pending"
msgstr "እየተጠበቀ"

msgid "No support messages yet"
msgstr "እስካሁን ምንም የድጋፍ መልዕክት የለም"

msgid "You haven't needed to reach out yet! If you ever face an issue, have a question, or need assistance, we're just a message away."
msgstr "እስካሁን ድጋፍ አላስፈለገዎትም! ጥያቄ ካለዎት እኛ ዝግጁ ነን።"

msgid "Write to Support"
msgstr "ለድጋፍ ሰጪ ቡድኑ ይፃፉ"

msgid "This action cannot be undone."
msgstr "ይህ ድርጊት ወደኋላ አይመለስም።"

msgid "Close"
msgstr "ዝጋ"

msgid "Are you sure you want to delete"
msgstr "በእርግጥ ማጥፋት ይፈልጋሉ"

msgid "This item will be permanently removed from your workspace."
msgstr "ይህ ንጥል ከዎርክስፔስዎ በቋሚነት ይወገዳል።"

msgid "Update Team Console"
msgstr "የቡድን ማስተዳደሪያውን (Console) ያሻሽሉ"

msgid "Build Your Team"
msgstr "ቡድንዎን ይገንቡ"

msgid "Draft your mission, define the roles you need, and launch your team into the Discover feed. Make it compelling to attract the best talent."
msgstr "ተልዕኮዎን ያዘጋጁ፣ የሚፈልጓቸውን ድርሻዎች ይግለጹ፣ እና ቡድንዎን ወደ 'ያግኙ' (Discover) ፊድ ይላኩ። ምርጥ ታለንቶችን ለመሳብ አሳማኝ ያድርጉት።"

msgid "Define Your Team"
msgstr "ቡድንዎን ይግለጹ"

msgid "Give your team a clear, memorable name that reflects your goals."
msgstr "ለቡድንዎ ግቦችዎን የሚያንፀባርቅ ግልጽ እና በቀላሉ የሚታወስ ስም ይስጡት።"

msgid "Team Name"
msgstr "የቡድን ስም"

msgid "Mission & Vision"
msgstr "ተልዕኮ እና ራዕይ"

msgid "Pro tip: Be clear about the problem you are solving to attract passionate members."
msgstr "ጠቃሚ ምክር፡ ፍላጎት ያላቸውን አባላት ለመሳብ የሚፈቱትን ችግር በግልጽ ያብራሩ።"

msgid "Who Are You Looking For?"
msgstr "ማንን ነው የሚፈልጉት?"

msgid "List specific skills, experience levels, or roles like 'UI Designer' or 'Backend Engineer'."
msgstr "የተወሰኑ ክህሎቶችን፣ የልምድ ደረጃዎችን፣ ወይም እንደ 'UI Designer' ያሉ ድርሻዎችን ይዘርዝሩ።"

msgid "Team Settings"
msgstr "የቡድን ቅንብሮች"

msgid "Team Category"
msgstr "የቡድን ዘርፍ"

msgid "What is the primary objective of this team?"
msgstr "የዚህ ቡድን ዋና ዓላማ ምንድነው?"

msgid "Group Chat Link"
msgstr "የግሩፕ ቻት ሊንክ"

msgid "Telegram, Discord, or Slack invite link for approved members."
msgstr "ለተፈቀደላቸው አባላት የቴሌግራም፣ ዲስኮርድ፣ ወይም ስላክ መጋበዣ ሊንክ።"

msgid "Ready to Launch?"
msgstr "ለመጀመር (Launch) ዝግጁ ነዎት?"

msgid "Your updates will be live in the network immediately."
msgstr "አፕዴቶችዎ ወዲያውኑ በኔትወርኩ ላይ በቀጥታ (Live) ይታያሉ።"

msgid "Once submitted, your team enters the Discover feed for people to apply."
msgstr "አንዴ ካስገቡ በኋላ፣ ሰዎች እንዲያመለክቱ ቡድንዎ ወደ 'ያግኙ' (Discover) ፊድ ይገባል።"

msgid "Launch Team"
msgstr "ቡድኑን ይጀምሩ (Launch)"

msgid "E.g., Project Phoenix"
msgstr "ምሳሌ፡ ፕሮጀክት ፊኒክስ"

msgid "What is the grand vision? Explain the problem you are solving..."
msgstr "ትልቁ ራዕይ ምንድነው? የሚፈቱትን ችግር ያብራሩ..."

msgid "E.g., We need a UI/UX designer and a backend developer skilled in Python..."
msgstr "ምሳሌ፡ የUI/UX ዲዛይነር እና በPython ክህሎት ያለው የባክ-ኤንድ (Backend) ዴቨሎፐር እንፈልጋለን..."

msgid "My Current Focus"
msgstr "የአሁኑ ትኩረቴ"

msgid "Post daily or weekly updates to build your real-time portfolio. The community uses this to discover your skills and reach out for collaboration."
msgstr "የቀጥታ (Real-time) ፖርትፎሊዮዎን ለመገንባት የየቀኑን ወይም የየሳምንቱን አፕዴቶች ይለጥፉ። ኮሚኒቲው ክህሎትዎን ለማግኘት እና አብሮ ለመስራት ይህንን ይጠቀማል።"

msgid "Learn about Current Focus"
msgstr "ስለ 'የአሁኑ ትኩረት' ይወቁ"

msgid "How it works"
msgstr "እንዴት እንደሚሰራ"

msgid "Manage"
msgstr "አስተዳድር"

msgid "Add New Focus"
msgstr "አዲስ ትኩረት ይጨምሩ"

msgid "Recent Community Thoughts"
msgstr "የቅርብ ጊዜ የኮሚኒቲ ሀሳቦች"

msgid "Total Likes"
msgstr "አጠቃላይ ላይክ"

msgid "Comments"
msgstr "አስተያየቶች (Comments)"

msgid "Broadcast your Focus"
msgstr "ትኩረትዎን ያሳውቁ (Broadcast)"

msgid "You haven't set a current focus. Update your status to start attracting the right people and opportunities."
msgstr "እስካሁን የአሁኑን ትኩረትዎን (Current Focus) አላስቀመጡም። ትክክለኛ ሰዎችን እና እድሎችን ለመሳብ ሁኔታዎን ያሻሽሉ።"

msgid "Teams I Lead"
msgstr "እኔ የምመራቸው ቡድኖች"

msgid "Initiatives you created and manage."
msgstr "እርስዎ የፈጠሯቸው እና የሚያስተዳድሯቸው ቡድኖች።"

msgid "Learn about Teams"
msgstr "ስለ ቡድኖች ይወቁ"

msgid "Create"
msgstr "ፍጠር"

msgid "Members"
msgstr "አባላት"

msgid "No Teams Built"
msgstr "ምንም ቡድን አልተገነባም"

msgid "Create a team to gather people around your idea."
msgstr "ሰዎችን በሀሳብዎ ዙሪያ ለመሰብሰብ ቡድን ይፍጠሩ።"

msgid "Teams Joined"
msgstr "የተቀላቀልኳቸው ቡድኖች"

msgid "Collaborations you are a part of."
msgstr "እርስዎ አባል የሆኑባቸው የጋራ ስራዎች።"

msgid "Active Member"
msgstr "ንቁ አባል"

msgid "No external teams"
msgstr "ምንም የውጭ ቡድን የለም"

msgid "Find open teams in Discover."
msgstr "በ 'ያግኙ' (Discover) ውስጥ ክፍት ቡድኖችን ፈልግ።"

msgid "Track your sent requests."
msgstr "የላኳቸውን ጥያቄዎች ይከታተሉ።"

msgid "Accepted"
msgstr "ተቀባይነት አግኝቷል"

msgid "Declined"
msgstr "ውድቅ ተደርጓል"

msgid "Reviewing"
msgstr "በመገምገም ላይ"

msgid "No applications sent"
msgstr "ምንም ማመልከቻ አልተላከም"

msgid "Apply to open roles and gigs."
msgstr "ክፍት ለሆኑ ስራዎች እና Gigs ያመልክቱ።"

msgid "Your Living Portfolio"
msgstr "የእርስዎ ህያው (Living) ፖርትፎሊዮ"

msgid "Stop Using Static Resumes"
msgstr "መደበኛ (Static) ሲቪዎችን (Resumes) መጠቀም ያቁሙ"

msgid "Resumes are outdated the minute you write them. Instead, use 'Current Focus' as a professional diary. Post short updates about what you are actively learning, building, or researching today."
msgstr "ሲቪዎች እንደተፃፉ ጊዜ ያለፈባቸው ይሆናሉ። በምትኩ፣ 'የአሁኑ ትኩረት'ን እንደ የሙያ ማስታወሻ ይጠቀሙ። ዛሬ ምን እየተማሩ፣ እየገነቡ፣ ወይም እየመረመሩ እንደሆነ አጫጭር አፕዴቶችን ይለጥፉ።"

msgid "Show Your Proof of Work"
msgstr "የስራ ማስረጃዎን ያሳዩ"

msgid "Whether you are writing a business plan, coding an app, or doing social work, posting updates provides indisputable proof of your skills and dedication over time."
msgstr "የቢዝነስ እቅድ እየፃፉ፣ አፕ እየሰሩ (Coding)፣ ወይም ማህበራዊ ስራ እየሰሩ ቢሆንም፣ አፕዴቶችን መለጠፍ የክህሎትዎ እና የቁርጠኝነትዎ ተጨባጭ ማስረጃ ይሰጣል።"

msgid "Attract Better Opportunities"
msgstr "የተሻሉ እድሎችን ይስቡ"

msgid "Recruiters and founders search the platform for active builders. A consistently updated Focus log makes you highly visible and proves you are driven."
msgstr "ቀጣሪዎች እና መስራቾች ንቁ ሰዎችን በፕላትፎርሙ ላይ ይፈልጋሉ። በመደበኛነት የሚሻሻል የትኩረት (Focus) መዝገብ በቀላሉ እንዲታዩ ያደርግዎታል እንዲሁም ተነሳሽነት እንዳለዎት ያረጋግጣል።"

msgid "Got it, let's post"
msgstr "ገብቶኛል፣ ልለጥፍ"

msgid "Build Your Crew"
msgstr "ቡድንዎን ይገንቡ"

msgid "Have an idea? Pitch it."
msgstr "ሀሳብ አለዎት? ያቅርቡት (Pitch it)።"

msgid "Want to start a startup, host an event, or build a school project? Create a Team. Write out your mission and define exactly who you need (e.g., 'Need a designer and a writer')."
msgstr "ስታርትአፕ መጀመር፣ ዝግጅት ማዘጋጀት፣ ወይም የትምህርት ቤት ፕሮጀክት መስራት ይፈልጋሉ? ቡድን ይፍጠሩ። ተልዕኮዎን ይፃፉ እና በትክክል ማንን እንደሚፈልጉ ይግለጹ (ምሳሌ፡ 'ዲዛይነር እና ፀሃፊ እፈልጋለሁ')።"

msgid "People Apply to Join"
msgstr "ሰዎች ለመቀላቀል ያመለክታሉ"

msgid "Your team goes live on the Discover feed. People who believe in your mission will apply by sending you a quick pitch of why they are a good fit."
msgstr "ቡድንዎ በ 'ያግኙ' (Discover) ፊድ ላይ በቀጥታ (Live) ይወጣል። በተልዕኮዎ የሚያምኑ ሰዎች ለምን ተስማሚ እንደሆኑ በማስረዳት (Pitch በማድረግ) ያመለክታሉ።"

msgid "Review and Assemble"
msgstr "ገምግም እና አሰባስብ"

msgid "Read their applications, look at their profile to see what they've built, and accept the best fits into your team workspace."
msgstr "ማመልከቻዎቻቸውን ያንብቡ፣ ምን እንደገነቡ ለማየት ፕሮፋይላቸውን ይመልከቱ፣ እና ተስማሚ የሆኑትን ወደ ቡድንዎ ዎርክስፔስ ይቀበሉ።"

msgid "Got it"
msgstr "ገብቶኛል"

msgid "Application Tracker"
msgstr "የማመልከቻ መከታተያ"

msgid "Track Everything"
msgstr "ሁሉንም ነገር ይከታተሉ"

msgid "When you apply for a job, a gig, or a spot in someone's team, it shows up here. You'll never have to guess if your application went through."
msgstr "ለስራ፣ ለGig፣ ወይም በአንድ ሰው ቡድን ውስጥ ቦታ ለማግኘት ሲያመለክቱ እዚህ ይታያል። ማመልከቻዎ መድረሱን ለመገመት አይገደዱም።"

msgid "Real-Time Status"
msgstr "የቀጥታ (Real-Time) ሁኔታ"

msgid "Watch your status change from 'Reviewing' to 'Accepted' in real-time. Remember, hirers will check your profile before accepting you, so keep your Current Focus updated!"
msgstr "ሁኔታዎ ከ 'በመገምገም ላይ' ወደ 'ተቀባይነት አግኝቷል' ሲቀየር በቀጥታ ይከታተሉ። ያስታውሱ፣ ቀጣሪዎች ከመቀበላቸው በፊት ፕሮፋይልዎን ስለሚመለከቱ፣ የአሁኑን ትኩረትዎን (Current Focus) ማዘመንዎን አይርሱ!"

msgid "Teams I've Joined"
msgstr "የተቀላቀልኳቸው ቡድኖች"

msgid "My Applications"
msgstr "የእኔ ማመልከቻዎች"

msgid "Create Team"
msgstr "ቡድን ይፍጠሩ"

msgid "Create your own team, assign roles, and manage your collaborative projects."
msgstr "የራስዎን ቡድን ይፍጠሩ፣ ድርሻዎችን ይመድቡ እና ፕሮጀክቶችን ያስተዳድሩ።"

msgid "No Teams Built Yet"
msgstr "እስካሁን ምንም ቡድን አልተገነባም"

msgid "Ready to build? Create your team and start managing."
msgstr "ለመገንባት ዝግጁ ነዎት? ቡድንዎን ይፍጠሩ።"

msgid "Find Teams"
msgstr "ቡድኖችን ፈልግ"

msgid "External projects and teams you are actively a part of."
msgstr "አባል የሆኑባቸው የውጭ ፕሮጀክቶች እና ቡድኖች።"

msgid "You haven't joined any external collaborations yet."
msgstr "እስካሁን ምንም የውጭ ትብብር አልተቀላቀሉም።"

msgid "Opportunities Posted"
msgstr "የተለጠፉ እድሎች"

msgid "Share jobs, gigs, or any opportunities you've found, and review your applicants here."
msgstr "ያገኟቸውን እድሎች እዚህ ያጋሩ እና አመልካቾችን ይገምግሙ።"

msgid "Total Applicants"
msgstr "ጠቅላላ አመልካቾች"

msgid "Edit Post"
msgstr "ፖስቱን ያስተካክሉ"

msgid "View Live"
msgstr "በቀጥታ ይመልከቱ"

msgid "No Active Job Posts"
msgstr "ምንም ንቁ የስራ ፖስት የለም"

msgid "Have an opening? Post a gig or job to find the right talent."
msgstr "ክፍት ስራ አለዎት? ተገቢውን ባለሙያ ለማግኘት እዚህ ይለጥፉ።"

msgid "Browse Jobs"
msgstr "ስራዎችን ያስሱ"

msgid "Track the status of gigs, jobs, and roles you've applied for."
msgstr "ያመለከቱባቸውን ስራዎች ሁኔታ እዚህ ይከታተሉ።"

msgid "Applied"
msgstr "አመልክቷል"

msgid "Under Review"
msgstr "በግምገማ ላይ ያለ"

msgid "You haven't submitted any applications recently."
msgstr "በቅርቡ ምንም ማመልከቻ አላስገቡም።"

msgid "Find Opportunities"
msgstr "እድሎችን ፈልግ"

msgid "Optimize Your Company Profile"
msgstr "የኩባንያ ፕሮፋይልዎን ያሳምሩ"

msgid "Upload your logo and a high-resolution cover image that represents your brand. Complete your profile by adding services and a mission statement to build trust with your network."
msgstr "ሎጎዎን እና ጥራት ያለው የጀርባ ምስል ይጫኑ። በማህበረሰቡ ዘንድ እምነትን ለመገንባት አገልግሎቶችን እና የተልዕኮ መግለጫን በመጨመር ፕሮፋይልዎን ያጠናቅቁ።"

msgid "Edit Cover"
msgstr "የጀርባ ምስሉን ያስተካክሉ"

msgid "Add Logo"
msgstr "ሎጎ ይጨምሩ"

msgid "Workspace Settings"
msgstr "የዎርክስፔስ ቅንብሮች"

msgid "Verified Business"
msgstr "የተረጋገጠ ቢዝነስ"

msgid "Verified"
msgstr "የተረጋገጠ"

msgid "Add one now."
msgstr "አሁኑኑ ይጨምሩ።"

msgid "Products"
msgstr "ምርቶች"

msgid "Detail your core offerings, pricing, and specific capabilities to attract clients."
msgstr "ደንበኞችን ለመሳብ አገልግሎቶችዎን፣ ዋጋዎን፣ እና የተለየ አቅምዎን በዝርዝር ያቅርቡ።"

msgid "Manage entries"
msgstr "ዝርዝሮችን ያስተዳድሩ"

msgid "Company Updates"
msgstr "የኩባንያ አፕዴቶች"

msgid "Publish important news, press releases, or significant announcements."
msgstr "ጠቃሚ ዜናዎችን፣ ጋዜጣዊ መግለጫዎችን፣ ወይም ማስታወቂያዎችን ያትሙ።"

msgid "Manage news"
msgstr "ዜናዎችን ያስተዳድሩ"

msgid "Document funding rounds, expansions, and key moments in your timeline."
msgstr "የፈንዲንግ ሂደቶችን፣ ማስፋፊያዎችን፣ እና በታይምላይንዎ ውስጥ ያሉ ቁልፍ ጊዜያትን ይመዝግቡ።"

msgid "Manage timeline"
msgstr "ታይምላይኑን ያስተዳድሩ"

msgid "Links & Socials"
msgstr "ሊንኮች እና ማህበራዊ ገጾች"

msgid "Centralize your website, social media channels, and external links."
