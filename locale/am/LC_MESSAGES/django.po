msgstr "ይህ መልዕክት ለሁሉም ሰው ይጥፋ?"

msgid "Tap to view"
msgstr "ለማየት ይጫኑ"

msgid "Read"
msgstr "ተነቧል"

msgid "Sent"
msgstr "ተልኳል"

msgid "Start the Conversation"
msgstr "ንግግር ይጀምሩ"

msgid "Send a message or share an attachment to begin networking."
msgstr "ኔትወርክ ለመጀመር መልዕክት ይላኩ ወይም ፋይል ያያይዙ።"

